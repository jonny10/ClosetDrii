<div class="nav-container">
  <header id="site-header">
    <div class="nav-content">
      <div class="nav-left">
        <a href="/" class="nav-logo">
          <img src="/assets/img/logo.png" alt="Closet Drii" />
          <div class="logo-text">
            <strong>Closet Drii</strong>
            <span>Fashion Store</span>
          </div>
        </a>

        <nav class="nav-menu" id="navMenu">
          <a href="/" class="nav-link">Home</a>
          <a href="/produtos" class="nav-link">Produtos</a>
          <a href="/cart" class="nav-link">Carrinho</a>

          {{#if isAdmin}}
          <a href="/dados" class="nav-link">Dados</a>
          <a href="/catalogo" class="nav-link">Catálogo</a>
          <a href="/vendas" class="nav-link">Vendas</a>
          <a href="/contact_adm" class="nav-link">Atendimento</a>
          {{/if}}
        </nav>
      </div>

      <div class="nav-right">
        {{#unless user}}
        <div class="guest-actions">
          <a href="/login" class="nav-btn secondary">Login</a>
          <a href="/signup" class="nav-btn primary">Cadastrar-se</a>
        </div>
        {{/unless}}

        {{#if user}}
        <div class="user-actions">
          <a href="/profile" class="nav-profile-btn" title="Meu Perfil">
            <i class="far fa-user-circle"></i>
            <span class="user-name">{{user.nome}}</span>
          </a>
          <button
            type="button"
            id="btn-logout"
            class="nav-btn secondary nav-logout-btn"
            title="Sair da conta"
          >
            <i class="fas fa-sign-out-alt"></i> Sair
          </button>
        </div>
        {{/if}}

        <button class="menu-toggle-btn" id="menuToggle" aria-label="Abrir Menu">
          <i class="fas fa-bars"></i>
        </button>
      </div>
    </div>
  </header>
</div>
