<main class="products-wrapper">
    <header class="page-header">
    <div class="header-content">
        <h1>Nossa Coleção</h1>
        <p>
        Explore peças exclusivas pensadas para realçar a sua autenticidade e
        estilo.
        </p>
    </div>
    </header>

    <div class="products-layout">
    <aside class="filters-sidebar">
        <div class="filter-box">
        <h3>Categorias</h3>
        <ul class="filter-list" id="categories-filter-list">
            <li>
            <label
                ><input type="checkbox" id="check-todos-categorias" checked />
                Todos</label
            >
            </li>
            {{#each categorias}}
            <li>
            <label
                ><input
                type="checkbox"
                class="category-checkbox"
                data-name="{{nome_lower}}"
                />
                {{nome}}</label
            >
            </li>
            {{/each}}
        </ul>
        </div>

        <div class="filter-box">
        <h3>Preço</h3>
        <div class="price-range">
            <input
            type="range"
            min="0"
            max="500"
            step="10"
            value="500"
            id="price-slider"
            />
            <div class="price-labels">
            <span>R$ 0</span>
            <span id="price-value">Até R$ 500</span>
            </div>
        </div>
        </div>

        <div class="filter-box">
        <h3>Tamanho</h3>
        <div class="size-chips">
            {{#each tamanhos}}
            <button class="size-chip">{{nome}}</button>
            {{/each}}
        </div>
        </div>
    </aside>

    <section class="catalog-section">
        <section class="search-section">
        <div class="search-box">
            <input
            type="text"
            id="search-input"
            placeholder="Buscar vestidos, conjuntos, blusas..."
            />
            <button aria-label="Pesquisar" id="search-btn">
            <i class="fas fa-search"></i>
            </button>
        </div>
        </section>

        <div
        id="applied-filters-container"
        class="applied-filters-wrapper"
        style="display: none"
        >
        <span class="title-label">Filtros ativos:</span>
        <div id="filters-badges-list" class="badges-list"></div>
        <button id="btn-clear-all-filters" class="clear-all-link">
            Limpar tudo
        </button>
        </div>

        <div class="catalog-controls">
        <p class="products-count">
            Mostrando <strong id="products-count-txt">0</strong> produtos
        </p>
        <div class="sort-wrapper">
            <label for="sort-select">Ordenar por:</label>
            <select id="sort-select">
            <option value="default">Padrão</option>
            <option value="price-asc">Menor Preço</option>
            <option value="price-desc">Maior Preço</option>
            </select>
        </div>
        </div>

        <div id="product-catalog-grid" class="product-grid">
        {{#each produtos}}
        <div
            class="product-card-component"
            data-id="{{id}}"
            data-preco="{{preco}}"
            data-categoria="{{categoria}}"
            data-tamanhos="{{tamanhos}}"
            data-busca="{{busca}}"
        >
            <div
            class="card-clickable-area open-modal-trigger"
            style="cursor: pointer"
            >
            <div class="image-wrapper">
                <img class="produto-img" src="{{imagem}}" alt="{{nome}}" />
                <span class="product-badge">Novo</span>
            </div>
            <div class="card-info">
                <h3 class="produto-nome">{{nome}}</h3>
                <p class="produto-preco">R$ {{preco_formatado}}</p>
            </div>
            </div>
            <button class="add-btn">Detalhes do produto</button>
        </div>
        {{/each}}
        </div>
    </section>
    </div>
</main>
