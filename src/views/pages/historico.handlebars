<main class="products-wrapper">
  <header class="page-header">
    <div class="header-content">
      <h1>Meus Pedidos</h1>
      <p>
        Acompanhe o status das suas compras e relembre seus looks favoritos
        da Closet Drii.
      </p>
    </div>
  </header>

  <div class="history-layout-grid">
    {{#if pedidos.length}}
    <section id="orders-container" class="orders-list-section">
      {{#each pedidos}}
      <div class="order-container-card">
        <div class="order-card-header">
          <div class="order-meta-info">
            <span>Pedido: <strong class="order-id">#{{id}}</strong></span>
            <span
              >Data: <strong class="order-date">{{data}}</strong></span
            >
          </div>
          <span class="order-status-badge status-{{status}}">{{status}}</span>
        </div>

        <div class="order-products-rows-list">
          {{#each itens}}
          <div class="order-product-item-row">
            <div class="product-item-main">
              <div class="product-item-image-box">
                <img
                  class="cart-img"
                  src="{{imagem_url}}"
                  alt="{{nome}}"
                />
              </div>
              <div class="product-item-details">
                <h3 class="cart-nome">{{nome}}</h3>
                <div class="item-specs">
                  <span
                    >Cor: <strong class="cart-cor">{{cor}}</strong></span
                  >
                  <span
                    >Tamanho:
                    <strong class="cart-tamanho">{{tamanho}}</strong></span
                  >
                </div>
                <p class="cart-preco-unitario">Unid: {{unitario}}</p>
              </div>
            </div>

            <div class="product-item-pricing-box">
              <span class="order-item-qty"
                >Qtd: <strong class="qty-count">{{quantidade}}</strong></span
              >
              <span class="cart-subtotal-item">{{subtotal}}</span>
            </div>
          </div>
          {{/each}}
        </div>

        <div class="order-card-footer">
          <span>Total do Pedido:</span>
          <strong class="order-total-price">{{total}}</strong>
        </div>
      </div>
      {{/each}}
    </section>
    {{else}}
    <div class="empty-history-card">
      <i class="fas fa-box-open"></i>
      <h2>Você ainda não fez compras</h2>
      <p>
        Que tal explorar nossa nova coleção de 2026 e encontrar o look
        perfeito?
      </p>
      <a href="/produtos" class="btn-primary-link">Ver Coleção</a>
    </div>
    {{/if}}
  </div>
</main>
