<main class="products-wrapper admin-crud-layout">
  <header class="admin-header-actions">
    <div>
      <h1>Controle de Catálogo</h1>
      <p>
        Gerencie produtos, categorias e monitore o estoque geral da
        plataforma.
      </p>
    </div>
    <div class="admin-header-actions-buttons">
      <button id="btn-open-categorias-modal" class="btn-secondary">
        <i class="fas fa-tags"></i> Categorias
      </button>
      <button id="btn-open-tamanhos-modal" class="btn-secondary">
        <i class="fas fa-ruler-combined"></i> Tamanhos
      </button>
      <button id="btn-open-create-modal" class="btn-primary">
        <i class="fas fa-plus"></i> Novo Produto
      </button>
    </div>
  </header>

  <section class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-icon icon-looks">
        <i class="fas fa-tshirt"></i>
      </div>
      <div class="kpi-details">
        <h3>Looks Cadastrados</h3>
        <p>{{kpis.totalProdutos}}</p>
        <span>Produtos distintos no catálogo</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon icon-variantes">
        <i class="fas fa-tags"></i>
      </div>
      <div class="kpi-details">
        <h3>Variações de Grade</h3>
        <p>{{kpis.totalVariantes}}</p>
        <span>Combinações cor/tamanho</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon icon-pecas">
        <i class="fas fa-boxes"></i>
      </div>
      <div class="kpi-details">
        <h3>Peças em Estoque</h3>
        <p>{{kpis.totalPecas}}</p>
        <span>Volume físico disponível</span>
      </div>
    </div>

    <div class="kpi-card">
      <div class="kpi-icon icon-preco">
        <i class="fas fa-chart-line"></i>
      </div>
      <div class="kpi-details">
        <h3>Preço Médio</h3>
        <p>R$ {{kpis.precoMedio}}</p>
        <span>Média do catálogo</span>
      </div>
    </div>
  </section>

  <section class="admin-search-wrapper">
    <div class="crud-search-box">
      <i class="fas fa-search"></i>
      <input
        type="text"
        id="crud-search-input"
        placeholder="Filtrar produtos por nome ou descrição..."
      />
    </div>
  </section>

  <section class="admin-table-container">
    <table class="crud-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome do Look</th>
          <th>Categoria</th>
          <th>Preço Base</th>
          <th>Variantes (Tam-Cor/Qtd)</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody id="crud-products-tbody">
        {{#each produtos}}
        <tr data-id="{{id}}" data-busca="{{busca}}">
          <td><strong>#{{id_formatado}}</strong></td>
          <td><span class="product-title-bold">{{nome}}</span></td>
          <td><span class="badge-category">{{categoria}}</span></td>
          <td><span class="product-price-highlight">R$ {{preco_formatado}}</span></td>
          <td>
            {{#if variantes.length}}
            <ul class="crud-variants-list">
              {{#each variantes}}
              <li><i class="fas fa-caret-right"></i> {{tamanho}}-{{cor}} <strong>({{estoque}})</strong></li>
              {{/each}}
            </ul>
            {{else}}
            <span class="no-variants-text">Sem variantes</span>
            {{/if}}
          </td>
          <td>
            <div class="action-buttons-wrapper">
              <button class="btn-action-edit" data-id="{{id}}" title="Editar Look"><i class="fas fa-edit"></i></button>
              <button class="btn-action-delete" data-id="{{id}}" title="Excluir Look"><i class="fas fa-trash"></i></button>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <section class="analytics-main-section stock-sections">
    <div class="analytics-card">
      <header class="analytics-card-header">
        <h2><i class="fas fa-layer-group"></i> Estoque por Categoria</h2>
        <p>Distribuição de looks e peças físicas por categoria.</p>
      </header>

      <table class="ranking-table">
        <thead>
          <tr>
            <th>Categoria</th>
            <th style="text-align: center">Looks</th>
            <th style="text-align: right">Peças em Estoque</th>
          </tr>
        </thead>
        <tbody>
          {{#each estoquePorCategoria}}
          <tr>
            <td>{{nome}}</td>
            <td style="text-align: center">{{looks}}</td>
            <td style="text-align: right"><strong>{{pecas}}</strong></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="analytics-card">
      <header class="analytics-card-header">
        <h2><i class="fas fa-exclamation-triangle"></i> Alertas de Reposição</h2>
        <p>Variantes com 3 peças ou menos em estoque.</p>
      </header>

      {{#if alertas.length}}
      <table class="ranking-table">
        <thead>
          <tr>
            <th>Look</th>
            <th>Variação</th>
            <th style="text-align: right">Estoque</th>
          </tr>
        </thead>
        <tbody>
          {{#each alertas}}
          <tr>
            <td>{{produto}}</td>
            <td>{{tamanho}}-{{cor}}</td>
            <td style="text-align: right"><strong>{{estoque}}</strong></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="no-variants-text">Nenhuma variante em estado crítico. 🎉</p>
      {{/if}}
    </div>
  </section>
</main>

<div id="product-crud-modal" class="admin-modal" style="display: none">
  <div class="modal-card modal-card--wide">
    <header class="modal-header">
      <h2 id="modal-title-context">Cadastrar Novo Look</h2>
      <button id="btn-close-modal" class="close-x-btn">&times;</button>
    </header>

    <form id="product-crud-form">
      <input type="hidden" id="form-product-id" />

      <div class="product-form-grid">
        <div class="product-form-column">
          <h3 class="column-subtitle">Dados do Produto</h3>

          <div class="form-group">
            <label for="form-nome">Nome do Produto</label>
            <input
              type="text"
              id="form-nome"
              required
              placeholder="Ex: Vestido Midi Satin"
            />
          </div>

          <div class="form-group">
            <label for="form-descricao">Descrição Detalhada</label>
            <textarea
              id="form-descricao"
              rows="3"
              required
              placeholder="Fibras, caimento, detalhes da estampa..."
            ></textarea>
          </div>

          <div class="form-row-double">
            <div class="form-group">
              <label for="form-preco">Preço de Venda (R$)</label>
              <input
                type="number"
                id="form-preco"
                step="0.01"
                required
                placeholder="180.00"
              />
            </div>

            <div class="form-group">
              <label for="form-categoria">Categoria</label>
              <select id="form-categoria" required>
                {{#each categorias}}
                <option value="{{id}}">{{nome}}</option>
                {{/each}}
              </select>
            </div>
          </div>
        </div>

        <div class="product-form-column variants-column">
          <div class="variants-column-header">
            <h3 class="column-subtitle">Grades e Variantes</h3>
            <button
              type="button"
              id="btn-add-variant-row"
              class="btn-text-action"
            >
              <i class="fas fa-plus-circle"></i> Adicionar Variante
            </button>
          </div>

          <div class="variants-table-header">
            <span>Tamanho</span>
            <span>Cor</span>
            <span>Qtd Estoque</span>
            <span>Imagem</span>
            <span>Ação</span>
          </div>

          <div
            id="form-variants-container"
            class="variants-rows-wrapper"
          ></div>
        </div>
      </div>

      <footer class="form-actions-footer">
        <button type="button" id="btn-cancel-form" class="btn-secondary">
          Cancelar
        </button>
        <button type="submit" class="btn-primary">
          Confirmar Salvamento
        </button>
      </footer>
    </form>
  </div>
</div>

<div id="categorias-modal" class="admin-modal" style="display: none">
  <div class="modal-card">
    <header class="modal-header">
      <h2
        id="categorias-modal-titulo"
        data-titulo-criacao="Gerenciar Categorias"
        data-titulo-edicao="Editando Categoria"
      >
        Gerenciar Categorias
      </h2>
      <button id="btn-close-categorias-modal" class="close-x-btn">&times;</button>
    </header>

    <form id="categoria-form">
      <input type="hidden" id="categoria-id" />

      <div class="form-row-double">
        <div class="form-group">
          <label for="categoria-nome">Nome</label>
          <input type="text" id="categoria-nome" required placeholder="Ex: Bolsas" />
        </div>

        <div class="form-group">
          <label for="categoria-descricao">Descrição</label>
          <input
            type="text"
            id="categoria-descricao"
            required
            placeholder="Ex: Bolsas e carteiras"
          />
        </div>
      </div>

      <div class="form-actions-footer">
        <button
          type="button"
          id="btn-reset-categoria"
          class="btn-secondary"
          data-label-criacao="Novo"
          data-label-edicao="Cancelar"
        >
          Novo
        </button>
        <button
          type="submit"
          id="btn-salvar-categoria"
          class="btn-primary"
          data-label-criacao="Salvar Categoria"
          data-label-edicao="Editar"
        >
          Salvar Categoria
        </button>
      </div>
    </form>

    <div class="categorias-list">
      {{#each categorias}}
      <div
        class="categoria-item"
        data-id="{{id}}"
        data-nome="{{nome}}"
        data-descricao="{{descricao}}"
      >
        <div>
          <strong>{{nome}}</strong>
          <span>{{looks}} look(s)</span>
        </div>
        <div class="action-buttons-wrapper">
          <button
            class="btn-action-edit btn-categoria-edit"
            data-id="{{id}}"
            title="Editar Categoria"
          >
            <i class="fas fa-edit"></i>
          </button>
          <button
            class="btn-action-delete btn-categoria-delete"
            data-id="{{id}}"
            title="Excluir Categoria"
          >
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</div>

<div id="tamanhos-modal" class="admin-modal" style="display: none">
  <div class="modal-card">
    <header class="modal-header">
      <h2
        id="tamanhos-modal-titulo"
        data-titulo-criacao="Gerenciar Tamanhos"
        data-titulo-edicao="Editando Tamanho"
      >
        Gerenciar Tamanhos
      </h2>
      <button id="btn-close-tamanhos-modal" class="close-x-btn">&times;</button>
    </header>

    <form id="tamanho-form">
      <input type="hidden" id="tamanho-id" />

      <div class="form-row-double">
        <div class="form-group">
          <label for="tamanho-nome">Sigla</label>
          <input type="text" id="tamanho-nome" required placeholder="Ex: 42" />
        </div>

        <div class="form-group">
          <label for="tamanho-ordem">Ordem de Exibição</label>
          <input
            type="number"
            id="tamanho-ordem"
            min="0"
            step="1"
            required
            placeholder="Ex: 9"
          />
        </div>
      </div>

      <div class="form-actions-footer">
        <button
          type="button"
          id="btn-reset-tamanho"
          class="btn-secondary"
          data-label-criacao="Novo"
          data-label-edicao="Cancelar"
        >
          Novo
        </button>
        <button
          type="submit"
          id="btn-salvar-tamanho"
          class="btn-primary"
          data-label-criacao="Salvar Tamanho"
          data-label-edicao="Editar"
        >
          Salvar Tamanho
        </button>
      </div>
    </form>

    <div class="tamanhos-list">
      {{#each tamanhos}}
      <div
        class="tamanho-item"
        data-id="{{id}}"
        data-nome="{{nome}}"
        data-ordem="{{ordem}}"
      >
        <div>
          <strong>{{nome}}</strong>
          <span>{{variantes}} variante(s)</span>
        </div>
        <div class="action-buttons-wrapper">
          <button
            class="btn-action-edit btn-tamanho-edit"
            data-id="{{id}}"
            title="Editar Tamanho"
          >
            <i class="fas fa-edit"></i>
          </button>
          <button
            class="btn-action-delete btn-tamanho-delete"
            data-id="{{id}}"
            title="Excluir Tamanho"
          >
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</div>

<div id="delete-confirm-modal" class="admin-modal" style="display: none">
  <div class="modal-card delete-modal-card">
    <header class="modal-header">
      <h2>Excluir Look</h2>
      <button id="btn-close-delete-modal" class="close-x-btn">
        &times;
      </button>
    </header>

    <div class="modal-body-text">
      <p>
        Você tem certeza que deseja deletar permanentemente este produto?
      </p>
      <p class="warning-text-alert">
        <i class="fas fa-exclamation-triangle"></i> Esta ação não poderá ser
        desfeita na base de dados.
      </p>
    </div>

    <footer class="form-actions-footer">
      <button type="button" id="btn-cancel-delete" class="btn-secondary">
        Cancelar
      </button>
      <button type="button" id="btn-confirm-delete" class="btn-primary">
        Excluir Permanentemente
      </button>
    </footer>
  </div>
</div>
